generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Categorías macro de solicitudes
// ============================================================
model Category {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  active      Boolean  @default(true)
  creado      DateTime @default(now())
}

// ============================================================
// Recaudos generales
// ============================================================
model Requirement {
  id               Int      @id @default(autoincrement())
  name             String
  condition        String
  requiresValidity  Boolean  @default(false)
  validityDays     Int      @default(0)
  mandatory        Boolean  @default(true)
  active           Boolean  @default(true)
  creado           DateTime @default(now())
}

// ============================================================
// Usuario del sistema (Alcaldía Piritú)
// ============================================================
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String // hash bcrypt
  nombre    String
  email     String?
  activo    Boolean  @default(true)
  creado    DateTime @default(now())

  accesos UserAcceso[]
}

// ============================================================
// Ventana del sistema (cada item del menú)
// ============================================================
model Ventana {
  id     Int    @id @default(autoincrement())
  clave  String @unique // dashboard, usuarios, accesos...
  titulo String
  orden  Int    @default(0)

  accesos UserAcceso[]
}

// ============================================================
// Permiso: qué ventanas puede ver cada usuario
// ============================================================
model UserAcceso {
  userId    Int
  ventanaId Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  ventana   Ventana @relation(fields: [ventanaId], references: [id], onDelete: Cascade)

  @@id([userId, ventanaId])
}

// ============================================================
// FASE 1: Áreas y Visitadores
// ============================================================

// Áreas de Atención (Direcciones/Departamentos)
model AttentionArea {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  cedula      String    @default("")
  responsable String    @default("")
  telefono    String    @default("")
  active      Boolean   @default(true)
  creado      DateTime  @default(now())

  visitors Visitor[]
}

// Visitadores (vinculados a AttentionArea) - Tarea 1.3
model Visitor {
  id        Int            @id @default(autoincrement())
  areaId    Int
  area      AttentionArea  @relation(fields: [areaId], references: [id], onDelete: Cascade)
  cedula    String         @default("")
  name      String
  phone     String?
  active    Boolean        @default(true)
  creado    DateTime       @default(now())

  @@index([areaId])
}

// ============================================================
// FASE 2: Solicitudes de Ayuda
// ============================================================

// Persona que solicita la ayuda (se reutiliza por cédula)
model Solicitante {
  id                   Int      @id @default(autoincrement())
  cedula               String   @unique
  nombre               String
  genero_id            Int
  fecha_nacimiento     DateTime
  telefono_habitacion  String   @default("")
  telefono_movil       String   @default("")
  email                String   @default("")
  estado_civil_id      Int?
  condicion_especial_id Int
  municipio_id         Int
  parroquia_id         Int
  direccion            String
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  solicitudes Solicitud[]
}

// Solicitud de ayuda
model Solicitud {
  id                    Int      @id @default(autoincrement())
  solicitanteId         Int
  solicitante           Solicitante @relation(fields: [solicitanteId], references: [id], onDelete: Restrict)

  solicitud_para        String   // "propia" | "menores"
  parentesco_id         Int?
  menor_cedula          String   @default("")
  menor_nombre          String   @default("")
  menor_genero_id       Int?
  menor_fecha_nacimiento DateTime?
  menor_condicion_especial_id Int?

  categoria_solicitud_id Int
  tipo_ayuda_id          Int

  estado                String   @default("pendiente") // pendiente | aprobada | rechazada
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  educacion             SolicitudEducacion?
  seguridadAlimentaria  SolicitudSeguridadAlimentaria?
  recaudos              SolicitudRecaudo[]

  @@index([solicitanteId])
  @@index([categoria_solicitud_id])
}

// Datos específicos: Educación
model SolicitudEducacion {
  id                   Int       @id @default(autoincrement())
  solicitudId          Int       @unique
  solicitud            Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  municipio_id         Int
  parroquia_id         Int?
  tipo_institucion_id  Int
  institucion_id       Int?
  uniformes            Json      @default("[]") // [{uniformeId, uniformeNombre, talla}]
  created_at           DateTime  @default(now())
}

// Datos específicos: Seguridad Alimentaria
model SolicitudSeguridadAlimentaria {
  id                        Int       @id @default(autoincrement())
  solicitudId               Int       @unique
  solicitud                 Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  nucleo_adultos            Int
  nucleo_menores_existe     Boolean   @default(false)
  nucleo_menores_cantidad   Int       @default(0)
  nucleo_discapacidad_existe Boolean  @default(false)
  nucleo_discapacidad_cantidad Int    @default(0)
  created_at                DateTime  @default(now())
}

// Recaudos adjuntados por solicitud
model SolicitudRecaudo {
  id              Int       @id @default(autoincrement())
  solicitudId     Int
  solicitud       Solicitud @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  requirementId   Int
  fileName        String    @default("")
  filePath        String    @default("")
  checked         Boolean   @default(false)
  created_at      DateTime  @default(now())

  @@index([solicitudId])
}